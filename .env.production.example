# Production Environment Variables for Vercel

# Required: PostgreSQL connection string
# For Neon: postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require
# For Supabase: postgresql://user:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=your-production-database-url

# Required: Session secret for encrypting cookies (generate with: openssl rand -base64 32)
SESSION_SECRET=your-secure-random-secret-key

# Optional: Comma-separated list of allowed origins for CORS
# Example: https://yourdomain.com,https://www.yourdomain.com
# Leave empty or remove to allow all origins
ALLOWED_ORIGINS=

# Vercel sets these automatically
NODE_ENV=production